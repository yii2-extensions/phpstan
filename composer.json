{
    "name": "yii2-extensions/phpstan",
    "type": "library",
    "description": "PHPStan extension for Yii2",
    "homepage": "https://yii2-framework.github.io/docs/extensions/phpstan/",
    "keywords": [
        "yii2",
        "phpstan"
    ],
    "license": "BSD-3-Clause",
    "support": {
        "docs": "https://yii2-framework.github.io/docs/extensions/phpstan/",
        "issues": "https://github.com/yii2-extensions/phpstan/issues",
        "source": "https://github.com/yii2-extensions/phpstan"
    },
    "authors": [
        {
            "name": "Wilmer Arambula",
            "email": "terabytesoftw@gmail.com",
            "homepage": "https://github.com/terabytesoftw",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "nikic/php-parser": "^4.1|^5.4",
        "phpstan/phpstan": "^2.3",
        "yiisoft/yii2": "~2.0.55 || ^22.0@dev"
    },
    "require-dev": {
        "brianium/paratest": "^7.12",
        "maglnet/composer-require-checker": "^4.7",
        "php-forge/coding-standard": "^0.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "yii2\\extensions\\phpstan\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "yii2\\extensions\\phpstan\\tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.7.x-dev"
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        },
        "skills": {
            "source": "skills"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "ondrejmirtes/composer-attribute-collector": true,
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "actionlint": "actionlint",
        "check-dependencies": "composer-require-checker check",
        "ecs": "ecs check --fix",
        "ecs-check": "ecs check --ansi",
        "rector": "rector process",
        "rector-check": "rector process --dry-run",
        "static": "phpstan --memory-limit=-1",
        "static-console": "phpstan --configuration=phpstan-console.neon --memory-limit=-1",
        "tests": "@php -d memory_limit=-1 vendor/bin/paratest",
        "zizmor": "zizmor --persona=pedantic .github"
    },
    "scripts-descriptions": {
        "actionlint": "Lints GitHub Actions workflows with actionlint.",
        "check-dependencies": "Verifies that used symbols are declared as Composer dependencies.",
        "ecs": "Applies coding standard fixes with ECS.",
        "ecs-check": "Checks coding standards with ECS without modifying files.",
        "rector": "Applies automated refactoring with Rector.",
        "rector-check": "Previews Rector refactoring without modifying files.",
        "static": "Runs static analysis with PHPStan.",
        "static-console": "Runs static analysis with PHPStan using the console application configuration.",
        "tests": "Runs PHPUnit.",
        "zizmor": "Audits GitHub Actions workflows with zizmor."
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
