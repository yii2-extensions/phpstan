{
    "name": "yii2-extensions/phpstan",
    "type": "library",
    "description": "PHPStan extension for Yii2",
    "keywords": [
        "yii2",
        "phpstan"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Wilmer Arambula",
            "email": "terabytesoftw@gmail.com",
            "homepage": "https://github.com/terabytesoftw",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "nikic/php-parser": "^4.1|^5.4",
        "phpstan/phpstan": "^2.3",
        "yiisoft/yii2": "~2.0.55 || ^22.0@dev"
    },
    "require-dev": {
        "maglnet/composer-require-checker": "^4.7",
        "php-forge/coding-standard": "^0.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "yii2\\extensions\\phpstan\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "yii2\\extensions\\phpstan\\tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        },
        "scaffold": {
            "allowed-packages": [
                "php-forge/baseline",
                "php-forge/coding-standard"
            ]
        },
        "skills": {
            "source": "skills"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "ondrejmirtes/composer-attribute-collector": true,
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "check-dependencies": "./vendor/bin/composer-require-checker check",
        "ecs": "./vendor/bin/ecs --fix",
        "rector": "./vendor/bin/rector process",
        "static": "./vendor/bin/phpstan --memory-limit=-1",
        "static-console": "./vendor/bin/phpstan --configuration=phpstan-console.neon --memory-limit=-1",
        "tests": "php -d memory_limit=-1 ./vendor/bin/phpunit",
        "ecs-check": "./vendor/bin/ecs check --ansi",
        "quality": [
            "actionlint",
            "codespell --config .github/linters/.codespellrc --skip=./.git,./vendor/*,./node_modules/*,./internal/*,./.phpunit.cache/*,./code_coverage/*,./runtime/*",
            "editorconfig-checker -config .github/linters/.editorconfig-checker.json",
            "markdownlint-cli2 --config .github/linters/.markdown-lint.yml '**/*.md' '#vendor/**' '#node_modules/**' '#internal/**' '#runtime/**'",
            "prettier --check --config .prettierrc.json --ignore-path .prettierignore '**/*.md' '**/*.{yml,yaml}' '!runtime/**' '!internal/**'",
            "yamllint -d 'extends: default\nrules:\n  comments:\n    min-spaces-from-content: 1\n  line-length: disable\n  truthy: disable' .github"
        ],
        "zizmor": "zizmor --persona=pedantic .github",
        "security": [
            "@zizmor",
            "gitleaks git --config .github/linters/.gitleaks.toml --redact"
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
