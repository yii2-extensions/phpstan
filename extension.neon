parameters:
    stubFiles:
        - stubs/yii.stub

    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    yii2:
        config_path: ''
        component_generics:
            user: identityClass
        rules:
            behaviorInvalidAsDefinition: false
            behaviorInvalidDefinition: false
            behaviorUnknownOption: false
            createObjectInvalidOptionType: false
            createObjectUnknownOption: false
            externalActionInvalidOptionType: false
            externalActionUnknownOption: false
            newInvalidOptionType: false
            newUnknownOption: false
            widgetInvalidOptionType: false
            widgetUnknownOption: false

parametersSchema:
    yii2: structure(
        [
            config_path: schema(string()),
            component_generics: schema(arrayOf(string(), string())),
            rules: structure(
                [
                    behaviorInvalidAsDefinition: bool(),
                    behaviorInvalidDefinition: bool(),
                    behaviorUnknownOption: bool(),
                    createObjectInvalidOptionType: bool(),
                    createObjectUnknownOption: bool(),
                    externalActionInvalidOptionType: bool(),
                    externalActionUnknownOption: bool(),
                    newInvalidOptionType: bool(),
                    newUnknownOption: bool(),
                    widgetInvalidOptionType: bool(),
                    widgetUnknownOption: bool()
                ]
            )
        ]
    )

conditionalTags:
    yii2\extensions\phpstan\rules\AttachBehaviorInvalidDefinitionRule:
        phpstan.rules.rule: %yii2.rules.behaviorInvalidDefinition%
    yii2\extensions\phpstan\rules\AttachBehaviorUnknownOptionRule:
        phpstan.rules.rule: %yii2.rules.behaviorUnknownOption%
    yii2\extensions\phpstan\rules\BehaviorsInvalidDefinitionRule:
        phpstan.rules.rule: %yii2.rules.behaviorInvalidDefinition%
    yii2\extensions\phpstan\rules\BehaviorsUnknownOptionRule:
        phpstan.rules.rule: %yii2.rules.behaviorUnknownOption%
    yii2\extensions\phpstan\rules\CreateObjectBehaviorUnknownOptionRule:
        phpstan.rules.rule: %yii2.rules.behaviorUnknownOption%
    yii2\extensions\phpstan\rules\CreateObjectInvalidAsDefinitionRule:
        phpstan.rules.rule: %yii2.rules.behaviorInvalidAsDefinition%
    yii2\extensions\phpstan\rules\CreateObjectInvalidOptionTypeRule:
        phpstan.rules.rule: %yii2.rules.createObjectInvalidOptionType%
    yii2\extensions\phpstan\rules\CreateObjectUnknownOptionRule:
        phpstan.rules.rule: %yii2.rules.createObjectUnknownOption%
    yii2\extensions\phpstan\rules\ExternalActionInvalidOptionTypeRule:
        phpstan.rules.rule: %yii2.rules.externalActionInvalidOptionType%
    yii2\extensions\phpstan\rules\ExternalActionUnknownOptionRule:
        phpstan.rules.rule: %yii2.rules.externalActionUnknownOption%
    yii2\extensions\phpstan\rules\NewObjectInvalidOptionTypeRule:
        phpstan.rules.rule: %yii2.rules.newInvalidOptionType%
    yii2\extensions\phpstan\rules\NewObjectUnknownOptionRule:
        phpstan.rules.rule: %yii2.rules.newUnknownOption%
    yii2\extensions\phpstan\rules\WidgetInvalidOptionTypeRule:
        phpstan.rules.rule: %yii2.rules.widgetInvalidOptionType%
    yii2\extensions\phpstan\rules\WidgetUnknownOptionRule:
        phpstan.rules.rule: %yii2.rules.widgetUnknownOption%

services:
    -
        class: yii2\extensions\phpstan\method\BehaviorMethodsClassReflectionExtension
        tags: [phpstan.broker.methodsClassReflectionExtension]
    -
        class: yii2\extensions\phpstan\property\ApplicationPropertiesClassReflectionExtension
        tags: [phpstan.broker.propertiesClassReflectionExtension]
        arguments:
            genericComponents: %yii2.component_generics%
    -
        class: yii2\extensions\phpstan\property\BehaviorPropertiesClassReflectionExtension
        tags: [phpstan.broker.propertiesClassReflectionExtension]
    -
        class: yii2\extensions\phpstan\rules\AttachBehaviorInvalidDefinitionRule
    -
        class: yii2\extensions\phpstan\rules\AttachBehaviorUnknownOptionRule
    -
        class: yii2\extensions\phpstan\rules\BehaviorsInvalidDefinitionRule
    -
        class: yii2\extensions\phpstan\rules\BehaviorsUnknownOptionRule
    -
        class: yii2\extensions\phpstan\rules\CreateObjectBehaviorUnknownOptionRule
    -
        class: yii2\extensions\phpstan\rules\CreateObjectInvalidAsDefinitionRule
    -
        class: yii2\extensions\phpstan\rules\CreateObjectInvalidOptionTypeRule
    -
        class: yii2\extensions\phpstan\rules\CreateObjectUnknownOptionRule
    -
        class: yii2\extensions\phpstan\rules\ExternalActionInvalidOptionTypeRule
    -
        class: yii2\extensions\phpstan\rules\ExternalActionUnknownOptionRule
    -
        class: yii2\extensions\phpstan\rules\NewObjectInvalidOptionTypeRule
    -
        class: yii2\extensions\phpstan\rules\NewObjectUnknownOptionRule
    -
        class: yii2\extensions\phpstan\rules\WidgetInvalidOptionTypeRule
    -
        class: yii2\extensions\phpstan\rules\WidgetUnknownOptionRule
    -
        class: yii2\extensions\phpstan\type\ActiveQueryDynamicMethodReturnTypeExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
    -
        class: yii2\extensions\phpstan\type\ActiveRecordGetAttributeDynamicMethodReturnTypeExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
    -
        class: yii2\extensions\phpstan\type\ActiveRecordQueryDynamicStaticMethodReturnTypeExtension
        tags: [phpstan.broker.dynamicStaticMethodReturnTypeExtension]
    -
        class: yii2\extensions\phpstan\type\ApplicationTypeNodeResolverExtension
        tags: [phpstan.phpDoc.typeNodeResolverExtension]
    -
        class: yii2\extensions\phpstan\type\ContainerDynamicMethodReturnTypeExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
    -
        class: yii2\extensions\phpstan\type\HeaderCollectionDynamicMethodReturnTypeExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
    -
        class: yii2\extensions\phpstan\type\LoggerMessagesExpressionTypeResolverExtension
        tags: [phpstan.broker.expressionTypeResolverExtension]
    -
        class: yii2\extensions\phpstan\type\ServiceLocatorDynamicMethodReturnTypeExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
    -
        class: yii2\extensions\phpstan\type\TargetFilterMessagesDynamicStaticMethodReturnTypeExtension
        tags: [phpstan.broker.dynamicStaticMethodReturnTypeExtension]
    -
        class: yii2\extensions\phpstan\ServiceMapResultCacheValueExtension
        tags: [phpstan.resultCacheValueExtension]
        arguments:
            genericComponents: %yii2.component_generics%

    - yii2\extensions\phpstan\PropertyTagTypeResolver
    - yii2\extensions\phpstan\ServiceMap(%yii2.config_path%)
